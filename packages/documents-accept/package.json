{
  "name": "@agent24/documents-accept",
  "version": "0.5.1",
  "private": true,
  "description": "DOC-1-09: the Documenting acceptance harness. Runs the S01 samples through the documents routes of a real daemon, scores the results against the gold labels and records the evidence (docs/documenting/acceptance/README.md).",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm --filter @agent24/data-dir build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @agent24/data-dir build && vitest run",
    "accept": "pnpm --filter @agent24/data-dir build && tsx src/cli.ts"
  },
  "dependencies": {
    "@agent24/data-dir": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@agent24/api-client": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  }
}
