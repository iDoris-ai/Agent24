{
  "name": "@agent24/wechat-bridge",
  "version": "0.6.0",
  "private": true,
  "description": "F3: development WeChat transport for agent24d over the official iLink Bot API. A finished user message is posted to POST /api/v1/inbound/events. The chat reply is only 已记录. Ported iLink protocol layer from heinu1 (bot/src/ilink).",
  "type": "module",
  "scripts": {
    "bridge": "pnpm --filter @agent24/data-dir build && tsx src/main.ts",
    "typecheck": "pnpm --filter @agent24/data-dir build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @agent24/data-dir build && vitest run"
  },
  "dependencies": {
    "@agent24/data-dir": "workspace:*",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@agent24/api-client": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  }
}
