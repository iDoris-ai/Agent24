    },
    {
      "method": "POST",
      "path": "/api/v1/agent24/knowledge/ui/candidates/:candidate_id/return",
      "op": "candidate.review"
    },
    {
      "method": "POST",
      "path": "/api/v1/agent24/knowledge/ui/candidates/:candidate_id/approve",
      "op": "candidate.approve"
    },
    {
      "method": "POST",
      "path": "/api/v1/agent24/knowledge/ui/documents/:knowledge_id/withdraw",
      "op": "entry.withdraw"
