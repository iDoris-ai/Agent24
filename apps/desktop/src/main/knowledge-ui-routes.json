    "note": "The host's copy: a subset of the pinned server list at this commit (knowledge-ui-routes.test.ts). C2-01c1/c2/c3 (WeKnora#141, #142, #143); write entries from S5 (#1670 c2)."
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/knowledge-bases",
      "op": "kb.list"
    },
    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/knowledge-bases/:kb_id",
      "op": "kb.get"
    },
    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/knowledge-bases/:kb_id/tags",
      "op": "tag.list"
    },
    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/knowledge-bases/:kb_id/documents",
      "op": "doc.list"
    },
    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/documents/:knowledge_id",
      "op": "doc.get"
    },
    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/documents/:knowledge_id/chunks",
      "op": "chunk.list"
    },
    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/knowledge-bases/:kb_id/wiki/pages",
      "op": "wiki.list"
    },
    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/knowledge-bases/:kb_id/wiki/pages/*slug",
