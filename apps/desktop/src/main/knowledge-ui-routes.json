    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/candidates",
      "op": "candidate.review"
    },
    {
      "method": "GET",
      "path": "/api/v1/agent24/knowledge/ui/candidates/:candidate_id",
