{
  "name": "@agent24/desktop",
  "homepage": "https://github.com/iDoris-ai/Agent24",
  "version": "0.6.0",
  "private": true,
  "description": "Agent24 Electron desktop shell",
  "author": {
    "name": "iDoris.ai",
    "email": "firsttorch66@gmail.com"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && node scripts/dev-prepare-backend.mjs && pnpm --filter @agent24/data-dir build && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron .",
    "build": "pnpm --filter @agent24/data-dir build && vite build && tsc -p tsconfig.electron.json && node scripts/ensure-open-design-component-dir.mjs",
    "build:rust:debug": "cargo build -p agent24d -p agent24-cli --manifest-path ../../rust/Cargo.toml",
    "build:rust": "cargo build --release -p agent24d -p agent24-cli --manifest-path ../../rust/Cargo.toml",
    "stage:open-design": "node scripts/stage-open-design-resources.mjs",
    "rebuild:open-design-native": "node scripts/rebuild-open-design-native.mjs",
    "pack:open-design": "node scripts/pack-open-design-component.mjs",
    "test:stage-open-design": "node --test scripts/stage-open-design-resources.test.mjs",
    "test:pack-open-design": "node --test scripts/pack-open-design-component.test.mjs",
    "test:open-design-mac-release": "node --test scripts/open-design-mac-release.test.mjs scripts/prepare-open-design-linux-resources.test.mjs scripts/check-open-design-release-asset.test.mjs",
    "build:mac": "pnpm build:rust && pnpm build && electron-builder --mac",
    "build:win": "pnpm build:rust && pnpm build && electron-builder --win",
    "build:linux": "pnpm build:rust && pnpm build && electron-builder --linux",
    "typecheck": "pnpm --filter @agent24/data-dir build && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "pnpm --filter @agent24/data-dir build && vitest run",
    "test:watch": "vitest",
    "release:mac": "bash scripts/release-mac.sh"
  },
  "dependencies": {
    "@agent24/api-client": "workspace:*",
    "@agent24/data-dir": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "ai.auraai.agent24",
    "productName": "Agent24",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".open-design-component",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "../../rust/target/release/agent24d",
          "to": "backend/agent24d"
        },
        {
          "from": "../../rust/target/release/agent24",
          "to": "backend/agent24"
        }
      ],
      "identity": "Huifeng Jiao (HYAP444FN9)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/backend/agent24d",
        "Contents/Resources/backend/agent24"
      ],
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "../../rust/target/release/agent24d.exe",
          "to": "backend/agent24d.exe"
        },
        {
          "from": "../../rust/target/release/agent24.exe",
          "to": "backend/agent24.exe"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "iDoris.ai <firsttorch66@gmail.com>",
      "executableName": "agent24-desktop",
      "extraResources": [
        {
          "from": "../../rust/target/release/agent24d",
          "to": "backend/agent24d"
        },
        {
          "from": "../../rust/target/release/agent24",
          "to": "backend/agent24"
        }
      ]
    },
    "deb": {
      "artifactName": "agent24-desktop_${version}_${arch}.${ext}"
    },
    "dmg": {
      "sign": true
    }
  }
}
